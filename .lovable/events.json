    "project.quiz_completed": {
      "event_schema_version": 1,
      "description": "A student submitted a lesson quiz and it was graded.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "course_slug",
          "module_slug"
        ],
        "properties": {
          "course_slug": {
            "type": "string"
          },
          "module_slug": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }

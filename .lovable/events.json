      "event_schema_version": 1,
      "description": "A student opened a released lesson in the portal.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "course_slug",
          "module_slug"
        ],
        "properties": {
          "course_slug": {
            "type": "string"
          },
          "module_slug": {
            "type": "string"
          }
        }
      }

    "project.module_completed": {
      "event_schema_version": 1,
      "description": "A student's quiz submission marked a module/day complete.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "course_slug",
          "module_slug"
        ],
        "properties": {
          "course_slug": {
            "type": "string"
